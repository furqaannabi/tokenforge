# Copy to .env (gitignored) and fill in.
#   set -a && source .env && set +a

# --- Networks -----------------------------------------------------------
# X Layer testnet is chain 1952, confirmed against the RPC: eth_chainId
# returns 0x7a0. The 195 figure that circulates is wrong. Mainnet is 196.
XLAYER_TESTNET_RPC_URL=https://xlayertestrpc.okx.com
XLAYER_RPC_URL=https://xlayerrpc.okx.com

# --- Verification -------------------------------------------------------
# OKLink API key, from https://www.oklink.com/account/my-api
OKLINK_API_KEY=

# --- Deployment ---------------------------------------------------------
# Prefer an encrypted keystore over a raw key in a file:
#
#   cast wallet import tokenforge-deployer --interactive
#   forge script script/Deploy.s.sol --account tokenforge-deployer --rpc-url xlayer_testnet
#
# PRIVATE_KEY below is the fallback for CI or a throwaway testnet wallet.
# Never point it at a key that holds real funds — anything in a dotfile is one
# stray `cat` or screen-share away from being public.
PRIVATE_KEY=

# Address that administers the issuer registry. Defaults to the deployer.
REGISTRY_ADMIN=

# Settlement currency the vaults pay coupons in. Leave blank on testnet to
# deploy a mock alongside the rest.
USDG_ADDRESS=
