# Copy to .env (gitignored) and fill in.
#   set -a && source .env && set +a

# --- Networks -----------------------------------------------------------
# X Layer testnet is chain 1952, confirmed against the RPC: eth_chainId
# returns 0x7a0. The 195 figure that circulates is wrong. Mainnet is 196.
XLAYER_TESTNET_RPC_URL=https://xlayertestrpc.okx.com
XLAYER_RPC_URL=https://xlayerrpc.okx.com

# --- Verification -------------------------------------------------------
# The oklink verifier needs no API key; X Layer's guide only requires one for
# Etherscan verification. Set this if a request comes back unauthorised.
OKLINK_API_KEY=

# --- Deployment ---------------------------------------------------------
# Prefer an encrypted keystore over a raw key in a file:
#
#   cast wallet import tokenforge-deployer --interactive
#   forge script script/Deploy.s.sol:Deploy --rpc-url xlayer_testnet \
#     --account tokenforge-deployer --broadcast
#
# For an unattended run, write the password to .keystore-password (gitignored)
# and add --password-file .keystore-password.
#
# PRIVATE_KEY is a fallback for CI or a throwaway testnet wallet. Never point it
# at a key holding real funds — anything in a dotfile is one stray `cat` or
# screen-share away from being public.
PRIVATE_KEY=

# Address administering the issuer registry. Defaults to the deployer.
REGISTRY_ADMIN=

# --- Deployed addresses -------------------------------------------------
# Fill in after running the deploy scripts. The values for the current X Layer
# testnet deployment are committed in deployments/xlayer-testnet.json.
ISSUER_REGISTRY_ADDRESS=
NOTE_FACTORY_ADDRESS=

# Settlement currency the vaults pay coupons in. On a network without a real
# USDG, deploy the mock: script/DeployMockUSDG.s.sol
USDG_ADDRESS=
