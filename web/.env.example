# WalletConnect / Reown project ID, from https://cloud.reown.com
#
# Without it the app still runs, but only browser-injected wallets (MetaMask,
# OKX Wallet) can connect — the WalletConnect relay that powers QR codes and
# mobile wallets needs this ID.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- Contracts ----------------------------------------------------------
# X Layer testnet is chain 1952 (verified against the RPC; the widely cited 195
# is wrong). Current deployed addresses are committed in
# contracts/deployments/xlayer-testnet.json.
NEXT_PUBLIC_CHAIN_ID=1952
NEXT_PUBLIC_ISSUER_REGISTRY_ADDRESS=
NEXT_PUBLIC_NOTE_FACTORY_ADDRESS=0x4941ed1f4785bf68083620566CC2c64D78c15aE4

# Settlement currency coupons are paid in. On testnet this is a freely mintable
# mock; on mainnet it must be the real USDG.
NEXT_PUBLIC_USDG_ADDRESS=

NEXT_PUBLIC_DEMO_VERIFIED_ISSUERS=

# --- Extraction service -------------------------------------------------
# The Hono service in ../backend. Uploads, extraction, and review go here.
NEXT_PUBLIC_EXTRACTION_API_URL=http://localhost:8787
NEXT_PUBLIC_SALE_DESK_ADDRESS=0xDA9DD5Ab32372507fFcD662f6FE1608901c1bbF5
