# Copy to .env. Bun loads it automatically — no dotenv needed.

# --- Database -----------------------------------------------------------
# Postgres, reached through Prisma's pg driver adapter.
# For a throwaway local instance: bunx prisma dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tokenforge?schema=public"

# --- Extraction ---------------------------------------------------------
# Gemini through its OpenAI-compatible endpoint, so the provider is a base URL
# and a key rather than a different SDK.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Override to point at any OpenAI-protocol provider. Leave unset for Gemini.
# OpenAI itself would be https://api.openai.com/v1
LLM_BASE_URL=

# Must support structured outputs (JSON schema response format).
LLM_MODEL=gemini-2.5-pro

# --- Server -------------------------------------------------------------
PORT=8787

# Comma-separated origins allowed to call this service. The Next.js app in
# ../web runs on 3000 in development.
CORS_ORIGINS=http://localhost:3000
