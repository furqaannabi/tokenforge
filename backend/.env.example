# Copy to .env. Bun loads it automatically — no dotenv needed.

# --- Database -----------------------------------------------------------
# Postgres, reached through Prisma's pg driver adapter.
# For a throwaway local instance: bunx prisma dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tokenforge?schema=public"

# --- Extraction ---------------------------------------------------------
# Google's own SDK. A PDF is a first-class input and the JSON Schema is native,
# neither of which the OpenAI-compatible endpoint covers.
# Key: https://aistudio.google.com/apikey


# Must support structured output and PDF input.

# For reading rather than reasoning: transcribing a scanned document.

# --- Document storage (Cloudflare R2) -----------------------------------
# R2 speaks the S3 API, so the AWS SDK talks to it unchanged. Uploads are
# optional: without these, /documents still accepts a text layer, but there is
# no stored file to show a reviewer.
# Credentials: Cloudflare dashboard > R2 > Manage API tokens
# Endpoint:    https://<account-id>.r2.cloudflarestorage.com
#              (or an S3 / MinIO endpoint — nothing here is R2-specific)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional. A public custom domain in front of the bucket, e.g.
# https://hack-s3.example.com — when set, document links are permanent and
# unsigned. Leave unset to keep the bucket private and serve signed URLs.
R2_PUBLIC_URL=

R2_BUCKET=tokenforge-documents

# --- Server -------------------------------------------------------------
PORT=8787

# Comma-separated origins allowed to call this service. The Next.js app in
# ../web runs on 3000 in development.
CORS_ORIGINS=http://localhost:3000

# --- Chain --------------------------------------------------------------
# Settlement currency addresses, one per currency the app offers. The service
# builds mint parameters from these so a browser cannot substitute its own.
USDG_ADDRESS=0x6AF29b12f4df68C9416A0DC87B80a718ed054A94
NOTE_FACTORY_ADDRESS=0xf7974A5bB7caAE07D6d0633B3f6Ac35fb8C06CB6

# --- Sessions -----------------------------------------------------------
# Signs the session cookie. At least 32 characters; generate with
# `openssl rand -hex 32`. Changing it logs everyone out, which is the
# intended way to invalidate every session at once.
AUTH_SECRET=

# --- automatic repayment ----------------------------------------------------
# The keeper calls collectFromBorrower on vaults whose instalment has fallen
# due. Optional: without it nothing collects automatically and repayment still
# works by hand from the note page.
#
# This key cannot move anyone's money. collectFromBorrower takes no arguments
# and no recipient — it moves the scheduled amount from the borrower named by
# the note into that note's vault, only once due, and only as far as the
# borrower's own allowance permits. It needs gas and nothing else, so fund it
# with a little OKB and keep nothing else in it.
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=60000

# --- Claude on Amazon Bedrock -----------------------------------------------
# Region is required: Bedrock has no default. Model access must also be granted
# once per account (Bedrock console -> Model access), or every call returns 403
# "not available for this account" even with valid credentials.
AWS_REGION=us-east-1

# Leave these blank to use the ambient AWS credential chain instead — a shared
# profile locally, or an instance role in production, which is the shape that
# keeps long-lived keys off the box. Fill them only when there is no chain to
# fall back on.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (STS, SSO, assumed roles).
AWS_SESSION_TOKEN=
# Or name a profile from ~/.aws/credentials instead of the keys above.
AWS_PROFILE=

# The `us.` prefix is a cross-region inference profile, not decoration: the
# bare anthropic.claude-sonnet-4-6 returns 404. Check what this account can
# invoke with `aws bedrock list-inference-profiles`.
LLM_MODEL=us.anthropic.claude-sonnet-4-6
LLM_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
# low | medium | high | xhigh | max — how hard the model works.
LLM_EFFORT=high
