// TokenForge extraction service.
//
// The database records how a set of on-chain terms came to exist: which
// document they were read from, what the model produced, what the deterministic
// validator said about it, and who signed off. Once a note is minted its terms
// are immutable on-chain — this is the audit trail explaining them.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  /// Submitted, awaiting a registry admin.
  PENDING
  /// Admitted on-chain. `admitTxHash` is the transaction that did it.
  APPROVED
  /// Turned down. `decisionNote` says why.
  REJECTED
  /// Pulled by the applicant before a decision.
  WITHDRAWN
}

/// A company asking to be admitted to the issuer registry.
///
/// Everything here is off-chain. `IssuerRegistry` stores only an address, a
/// name and a jurisdiction, because that is all the contract needs to enforce
/// who may mint — the corporate detail behind an admission, and the record of
/// applications that were refused, have no business on a public chain.
///
/// This service never admits anyone. Admission is a transaction signed by the
/// registry admin's own wallet; `admitTxHash` records the one that did it.
model IssuerApplication {
  id String @id @default(cuid())

  /// The address that will mint if admitted. Lowercased, so a checksum
  /// difference cannot produce two applications for one wallet.
  walletAddress String @unique

  companyName        String
  jurisdiction       String
  registrationNumber String?
  contactEmail       String
  website            String?

  /// Free text from the applicant: what they intend to tokenize.
  description String?

  status ApplicationStatus @default(PENDING)

  /// Set on approval or rejection.
  decisionNote String?
  decidedAt    DateTime?
  /// The admin address that decided, for the audit trail.
  decidedBy    String?

  /// The on-chain admission, once it has been signed and confirmed.
  admitTxHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// A source agreement. One document produces at most one note, which
/// `NoteFactory` also enforces on-chain by claiming the hash.
model Document {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String   @default("application/pdf")
  byteSize  Int

  /// keccak256 of the file bytes, written on-chain for provenance. Unique here
  /// for the same reason the factory rejects a repeat: one agreement must not
  /// be sold twice through two tokens.
  contentHash String @unique

  /// Text layer used for extraction, from the PDF itself or OCR.
  text String

  /// Object key in R2, content-addressed by `contentHash`. Null when only a
  /// text layer was supplied, or when storage is not configured.
  storageKey String?

  uploadedBy  String?
  createdAt   DateTime     @default(now())
  extractions Extraction[]

  @@index([createdAt])
}

enum ExtractionStatus {
  /// Model call in flight.
  PENDING
  /// Extracted, but at least one field is below the confidence threshold.
  NEEDS_REVIEW
  /// The validator found an inconsistency. Unmintable regardless of review.
  INVALID
  /// Consistent and fully reviewed. Ready for an issuer to approve.
  VALIDATED
  /// Minted on-chain.
  MINTED
  /// Abandoned by a reviewer.
  REJECTED
}

/// One pass of the extraction pipeline over one document.
///
/// Kept as a record rather than overwritten, so a re-run can be compared
/// against what a human previously saw and approved.
model Extraction {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Model identifier, so results stay attributable after an upgrade.
  model     String
  status    ExtractionStatus @default(PENDING)

  /// ExtractedTerms: every field with its value, confidence, and source quote.
  terms Json

  /// Validator findings. Empty array means internally consistent.
  issues Json @default("[]")

  /// Mirrors the validator's verdict, denormalised so the queue can filter on
  /// it without parsing `issues`.
  consistent Boolean @default(false)

  /// Field keys still awaiting human confirmation.
  unreviewedFields String[] @default([])

  /// Two checks a hash cannot make: whether the document's lender is the
  /// issuer applying to mint it, and whether the same agreement has already
  /// been extracted under a different file. Null until the check has run.
  /// Shape is `provenanceSchema` in src/provenance.ts.
  provenance Json?

  /// The exact parameters the issuer intends to mint, and the hash of them
  /// the admin approves on-chain. Stored so the admin's queue shows what is
  /// being asked for, and so the mint that follows uses the same values —
  /// anything else produces a different hash and the factory refuses it.
  mintRequest Json?

  /// Cost and latency, for judging whether the pipeline is affordable at scale.
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  note Note?

  @@index([documentId, createdAt])
  @@index([status])
}

/// The on-chain result. Written after `NoteFactory.mintNote` confirms.
model Note {
  id           String     @id @default(cuid())
  extractionId String     @unique
  extraction   Extraction @relation(fields: [extractionId], references: [id])

  chainId      Int
  noteAddress  String
  vaultAddress String
  issuerAddress String
  txHash       String @unique
  blockNumber  BigInt

  name   String
  symbol String

  mintedAt DateTime @default(now())

  @@unique([chainId, noteAddress])
  @@index([issuerAddress])
}
